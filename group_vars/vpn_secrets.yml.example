# Пример секретов для OpenVPN.
# Не храните реальный файл в git; используйте ansible-vault или отдельный секретный store.
openvpn_ca_cert: |
  -----BEGIN CERTIFICATE-----
  ...
  -----END CERTIFICATE-----

openvpn_server_cert: |
  -----BEGIN CERTIFICATE-----
  ...
  -----END CERTIFICATE-----

openvpn_server_key: |
  -----BEGIN PRIVATE KEY-----
  ...
  -----END PRIVATE KEY-----

openvpn_dh_params: |
  -----BEGIN DH PARAMETERS-----
  ...
  -----END DH PARAMETERS-----
